# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: for API routes that need elevated permissions (e.g. service role)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Higgsfield (format: key:secret or just key)
HIGGSFIELD_API_KEY=your-higgsfield-key

# Pour le QR code : URL accessible depuis les téléphones
# En local : ton IP (ex: http://192.168.1.42:3000) - trouve-la avec "ipconfig getifaddr en0" (Mac)
# En prod : https://ton-domaine.vercel.app
NEXT_PUBLIC_APP_URL=
